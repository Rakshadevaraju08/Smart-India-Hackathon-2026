# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Heavy Datasets & Google Drive Data Vault
Datasets/
Google_Drive_Datasets/
google_drive_datasets/

# Large Binary Archives (Stored in Google Drive)
*.zip
*.tar.gz
*.rar
*.7z
*.nc
*.nc4
*.tif
*.tiff
*.h5
*.hdf5

# Heavy Presentation Binaries & Documents
*.pptx
*.ppt
*.pdf
*.docx
*.xlsx

# Heavy Remote Sensing, DEM & Climate Rasters (Stored in Google Drive)
*.tif
*.tiff
*.hgt
*.nc
*.nc4

# Heavy Soil Rasters & Raw High-Resolution Imagery (>25MB)
Datasets/**/soil/*.png
Datasets/**/soil/*.png.png
Datasets/**/soil/*.jpg
Datasets/**/soil/*.jpeg

# Heavy Raw OpenStreetMap Polygons (>50MB, Stored in Google Drive)
Datasets/**/oms_network/*building*.geojson
Datasets/**/oms_network/Road*.geojson

# Heavy Engineering Drawings / PDF Reports in raw datasets
Datasets/**/*.pdf
Datasets/**/*.PDF
Datasets/**/*.mht
Datasets/**/*.MHT

# Environment secrets
.env
.env.local

# Agent scratch logs
.agents/
